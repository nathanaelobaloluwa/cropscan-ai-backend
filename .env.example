# ==============================================================================
# CropScan AI Backend — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / macOS:      cp .env.example .env
#
# Note: '.env' is automatically ignored by Git and should NEVER contain real
# production credentials, tokens, or production secret keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Flask Runtime Configuration
# ------------------------------------------------------------------------------
# FLASK_APP: Entry point module for Flask CLI commands.
FLASK_APP=run.py

# FLASK_ENV: Application environment mode ('development', 'testing', 'production').
# Defaults to 'development' if unset.
# In 'production' mode, the application enforces strict SECRET_KEY validation.
FLASK_ENV=development

# ------------------------------------------------------------------------------
# 2. Server Host and Port (run.py)
# ------------------------------------------------------------------------------
# HOST: Network interface to bind.
# - '127.0.0.1': Localhost only (default, recommended for local development).
# - '0.0.0.0':   All network interfaces (required inside Docker containers/PaaS).
HOST=127.0.0.1

# PORT: TCP port to bind (integer range: 1 to 65535). Defaults to 5000.
# The server validates this setting at startup. If missing, empty, non-numeric,
# fractional (e.g. 5000.5), or out of range, it logs a warning and falls back to 5000.
PORT=5000

# ------------------------------------------------------------------------------
# 3. Application Security & Cryptographic Signing
# ------------------------------------------------------------------------------
# SECRET_KEY: Used for session security, CSRF protection, and cryptographic signing.
#
# DEVELOPMENT MODE:
# - If unset or left as the default below, the app uses 'dev-secret-key-cropscan'.
#
# PRODUCTION MODE (FLASK_ENV=production):
# - MUST be explicitly set to a unique, cryptographically random string.
# - Application startup will FAIL with a ValueError if SECRET_KEY is missing,
#   empty, whitespace-only, or matches any known insecure development default.
# - Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
# - NEVER commit real production secrets to version control.
SECRET_KEY=dev-secret-key-cropscan-change-in-production

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed frontend origins.
# - In DEVELOPMENT (FLASK_ENV=development): Defaults to common local frontend ports:
#   http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# - In PRODUCTION (FLASK_ENV=production): Defaults to empty [] (no origins allowed).
#   MUST be explicitly set to your production frontend domain (e.g. https://cropscan.vercel.app).
#   Never use '*' in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 5. MobileNetV2 Vision Model & Inference
# ------------------------------------------------------------------------------
# CROPSCAN_MODEL_NAME: Hugging Face model repository or local directory path.
# Defaults to the fine-tuned 38-class MobileNetV2 plant disease vision model.
CROPSCAN_MODEL_NAME=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# PREDICTOR_DEVICE: Computation device for PyTorch tensor inference ('cpu' or 'cuda').
# Defaults to 'cpu' for portable, cost-effective inference without requiring a GPU.
PREDICTOR_DEVICE=cpu

# ------------------------------------------------------------------------------
# 6. Prediction Confidence Thresholding
# ------------------------------------------------------------------------------
# PREDICTION_CONFIDENCE_THRESHOLD: Minimum softmax activation score required for
# a confident prediction (valid range: 0.0 to 1.0 inclusive).
# - Defaults to 0.40 (provisional screening baseline).
# - Validated at startup and service initialization. If set to an empty string,
#   non-numeric value ('abc'), NaN, Infinity, or outside [0.0, 1.0], the system
#   logs a warning and safely falls back to 0.40 without crashing.
PREDICTION_CONFIDENCE_THRESHOLD=0.40
