# CropScan AI Backend Environment Configuration

# Flask runtime configuration
FLASK_APP=run.py
FLASK_ENV=development

# Server host and port
HOST=127.0.0.1
PORT=5000

# Security (change this in production)
SECRET_KEY=dev-secret-key-cropscan-change-in-production

# MobileNetV2 Vision Model Configuration
CROPSCAN_MODEL_NAME=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
PREDICTOR_DEVICE=cpu

# Provisional confidence threshold (0.40) - uncalibrated screening threshold
PREDICTION_CONFIDENCE_THRESHOLD=0.40
